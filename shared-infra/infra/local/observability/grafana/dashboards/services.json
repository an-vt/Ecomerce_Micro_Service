      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(http_server_duration_seconds_bucket{route!~\"/health.*|/metrics|unmatched\"}[5m]))))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
