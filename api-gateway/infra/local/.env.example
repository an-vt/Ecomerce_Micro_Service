SERVICE_NAME=api-gateway
APP_ENV=local
HTTP_PORT=8088
LOG_LEVEL=info
KAFKA_BROKERS=ecom-kafka:9092
REDIS_ADDR=ecom-redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://ecom-alloy:4317
GRPC_TIMEOUT_MS=2000
BREAKER_ERROR_PCT=50
BREAKER_VOLUME=10
BREAKER_WINDOW_MS=10000
BREAKER_RESET_MS=30000
AUTH_GRPC_ADDR=ecom-auth:9101
AUTH_JWT_ISSUER=ecom-auth
AUTH_JWT_AUDIENCE=ecom
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
RATE_LIMIT_PER_MIN=10000
AUTH_RATE_LIMIT_PER_MIN=1000
CATALOG_GRPC_ADDR=ecom-catalog:9102
INVENTORY_GRPC_ADDR=ecom-inventory:9103
