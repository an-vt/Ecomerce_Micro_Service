SERVICE_NAME=notification-service
APP_ENV=local
HTTP_PORT=8108
GRPC_PORT=50058
LOG_LEVEL=info
KAFKA_BROKERS=ecom-kafka:9092
REDIS_ADDR=ecom-redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://ecom-alloy:4317
GRPC_TIMEOUT_MS=2000
BREAKER_ERROR_PCT=50
BREAKER_VOLUME=10
BREAKER_WINDOW_MS=10000
BREAKER_RESET_MS=30000
MONGO_URI=mongodb://notification:notification@ecom-mongo:27017/notification_db?replicaSet=rs0&authSource=notification_db
