  "cards": [
    {
      "dot": "emerald",
      "title": "Checkout saga",
      "items": [
        "POST /orders → order PENDING + saga + outbox row in one transaction, 202 to the client",
        "ReserveStock → ApplyDiscounts (if any) → ProcessPayment → CommitStock, each a Kafka command answered on order.saga.replies",
        "A failed step compensates in reverse order → CANCELLED; success → CONFIRMED and order.order.confirmed clears the cart"
      ]
    },
    {
      "dot": "violet",
      "title": "Messaging guarantees",
      "items": [
        "Producers (auth, catalog, inventory, discount, order, payment) write a transactional outbox drained by a relay",
        "Consumers run under an inbox guard and dead-letter to <topic>.dlq; cart and notification only consume",
        "Synchronous calls are gRPC with deadlines and gobreaker; order calls catalog and discount only to review a checkout"
      ]
    },
    {
      "dot": "rose",
      "title": "Edge and shared state",
      "items": [
        "The gateway verifies RS256 tokens locally with keys from auth's JWKS and caches RBAC grants",
        "Redis also holds auth's revoked-session list and catalog's SKU cache (not drawn)",
        "Catalog only signs S3 upload URLs; clients PUT images straight to the bucket when media is configured"
      ]
    },
    {
      "dot": "amber",
      "title": "Data and observability",
      "items": [
        "One PostgreSQL 17 instance and one MongoDB 8.2 replica set, a separate database per service",
        "OTLP traces → Grafana Alloy → Tempo; Prometheus scrapes every /metrics plus DB/Kafka exporters",
        "Alloy ships container logs to Loki; Grafana dashboards and Alertmanager run under the observability profile"
      ]
    }
  ]
}