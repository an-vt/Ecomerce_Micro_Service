SERVICE_NAME=auth-service
APP_ENV=local
HTTP_PORT=8101
GRPC_PORT=9101
LOG_LEVEL=info
KAFKA_BROKERS=ecom-kafka:9092
REDIS_ADDR=ecom-redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://ecom-alloy:4317
GRPC_TIMEOUT_MS=2000
BREAKER_ERROR_PCT=50
BREAKER_VOLUME=10
BREAKER_WINDOW_MS=10000
BREAKER_RESET_MS=30000
DATABASE_URL=postgres://auth:auth@ecom-postgres:5432/auth_db?sslmode=disable
AUTH_JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem
AUTH_JWT_ISSUER=ecom-auth
AUTH_JWT_AUDIENCE=ecom
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
OTP_TTL_SEC=300
VERIFY_LINK_BASE=http://localhost:3000/v1/api/user/welcome_back
BCRYPT_COST=10
AUTO_MIGRATE=true
SEED_API_KEY=dev-api-key-change-me
SEED_ADMIN_EMAIL=admin@ecom.local
SEED_ADMIN_PASSWORD=admin-change-me-123
