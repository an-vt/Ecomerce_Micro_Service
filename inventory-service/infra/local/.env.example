SERVICE_NAME=inventory-service
APP_ENV=local
HTTP_PORT=8103
GRPC_PORT=9103
LOG_LEVEL=info
KAFKA_BROKERS=ecom-kafka:9092
REDIS_ADDR=ecom-redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://ecom-alloy:4317
GRPC_TIMEOUT_MS=2000
BREAKER_ERROR_PCT=50
BREAKER_VOLUME=10
BREAKER_WINDOW_MS=10000
BREAKER_RESET_MS=30000
DATABASE_URL=postgres://inventory:inventory@ecom-postgres:5432/inventory_db?sslmode=disable
RESERVATION_TTL_MS=900000
RESERVATION_SWEEP_MS=30000
AUTO_MIGRATE=true
