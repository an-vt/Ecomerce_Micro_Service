SERVICE_NAME=catalog-service
APP_ENV=local
HTTP_PORT=8102
GRPC_PORT=9102
LOG_LEVEL=info
KAFKA_BROKERS=ecom-kafka:9092
REDIS_ADDR=ecom-redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://ecom-alloy:4317
GRPC_TIMEOUT_MS=2000
BREAKER_ERROR_PCT=50
BREAKER_VOLUME=10
BREAKER_WINDOW_MS=10000
BREAKER_RESET_MS=30000
MONGO_URI=mongodb://catalog:catalog@ecom-mongo:27017/catalog_db?replicaSet=rs0&authSource=catalog_db
MONGO_DB=catalog_db
SKU_CACHE_TTL_SEC=30
AUTO_MIGRATE=true
# Product image uploads (P13, optional): presigned PUT straight to an S3-compatible store. Remove MEDIA_ENDPOINT to turn off.
# MEDIA_ENDPOINT is the address CLIENTS use (the signature covers the host), so it is the host-published port, not ecom-s3.
MEDIA_ENDPOINT=http://localhost:8000
MEDIA_BUCKET=ecom-media
MEDIA_ACCESS_KEY=ecomaccess
MEDIA_SECRET_KEY=ecomsecret-change-me
MEDIA_PATH_STYLE=true
MEDIA_URL_TTL_SEC=300
MEDIA_MAX_BYTES=5242880
