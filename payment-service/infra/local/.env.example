SERVICE_NAME=payment-service
APP_ENV=local
HTTP_PORT=8107
LOG_LEVEL=info
KAFKA_BROKERS=ecom-kafka:9092
REDIS_ADDR=ecom-redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://ecom-alloy:4317
BREAKER_ERROR_PCT=50
BREAKER_VOLUME=10
BREAKER_WINDOW_MS=10000
BREAKER_RESET_MS=30000
DATABASE_URL=postgres://payment:payment@ecom-postgres:5432/payment_db?sslmode=disable
AUTO_MIGRATE=true
PAYMENT_PROVIDER_TIMEOUT_MS=3000
PAYMENT_CURRENCY=VND
